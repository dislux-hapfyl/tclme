
namespace eval TclmeUser {}

# ----------------------------------------------------------------------------
# Medium Solarized
# ----------------------------------------------------------------------------

proc TclmeUser::ApplySolarizedMedium {} {
    # Solarized palette used:
    #
    # base03   #002b36
    # base02   #073642
    # base01   #586e75
    # base00   #657b83
    # base0    #839496
    # base1    #93a1a1
    # base2    #eee8d5
    # base3    #fdf6e3
    # yellow   #b58900
    # orange   #cb4b16
    # red      #dc322f
    # magenta  #d33682
    # violet   #6c71c4
    # blue     #268bd2
    # cyan     #2aa198
    # green    #859900

    set colors [dict create \
        bg          "#eee8d5" \
        fg          "#657b83" \
        editor_bg   "#eee8d5" \
        editor_fg   "#586e75" \
        status_bg   "#073642" \
        status_fg   "#93a1a1" \
        minibuf_bg  "#eee8d5" \
        minibuf_fg  "#586e75" \
        accent      "#268bd2" \
        separator   "#d8d1be" \
        scrollbar   "#cfc7b2" \
        cursor      "#cb4b16" \
    ]

    # Preferred path: use the Tclme theme API.
    if {[info commands Tclme::SetTheme] ne ""} {
        dict for {key value} $colors {
            catch { Tclme::SetTheme $key $value }
        }

        catch { Tclme::ApplyTheme }
    } else {
        # Fallback: directly modify the theme dictionary if it exists.
        if {[info exists Tclme::theme]} {
            dict for {key value} $colors {
                catch { dict set Tclme::theme $key $value }
            }

            catch { Tclme::Emit theme-changed }
        }
    }

    catch { Tclme::Message "Medium Solarized theme applied" }
}

# ----------------------------------------------------------------------------
# Optional: medium-dark Solarized variant
# ----------------------------------------------------------------------------

proc TclmeUser::ApplySolarizedMediumDark {} {
    set colors [dict create \
        bg          "#002b36" \
        fg          "#839496" \
        editor_bg   "#073642" \
        editor_fg   "#93a1a1" \
        status_bg   "#002b36" \
        status_fg   "#93a1a1" \
        minibuf_bg  "#073642" \
        minibuf_fg  "#93a1a1" \
        accent      "#268bd2" \
        separator   "#0e4c58" \
        scrollbar   "#0e4c58" \
        cursor      "#cb4b16" \
    ]

    if {[info commands Tclme::SetTheme] ne ""} {
        dict for {key value} $colors {
            catch { Tclme::SetTheme $key $value }
        }

        catch { Tclme::ApplyTheme }
    } else {
        if {[info exists Tclme::theme]} {
            dict for {key value} $colors {
                catch { dict set Tclme::theme $key $value }
            }

            catch { Tclme::Emit theme-changed }
        }
    }

    catch { Tclme::Message "Medium-dark Solarized theme applied" }
}


Tclme::DefCommand    theme-solarized-medium      TclmeUser::ApplySolarizedMedium     "Apply medium Solarized theme"
Tclme::DefCommand    theme-solarized-medium-dark TclmeUser::ApplySolarizedMediumDark "Apply medium-dark Solarized theme"
Tclme::DefAlias sol  theme-solarized-medium 
Tclme::DefAlias sold theme-solarized-medium-dark 



TclmeUser::ApplySolarizedMedium
;# TclmeUser::ApplySolarizedMediumDark